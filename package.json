{
  "name": "awesome-nswds",
  "version": "0.0.0",
  "description": "A curated list of resources for people building digital products for the NSW Government.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/digitalnsw/awesome-nswds.git"
  },
  "license": "CC0-1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "prepare": "husky",
    "branch:create": "scripts/create-branch.sh",
    "branch:suggest": "scripts/suggest-branch-name.sh",
    "branch:suggest:create": "scripts/suggest-branch-name.sh --create",
    "commit": "scripts/git-commit.sh",
    "pr": "scripts/pull-request.sh",
    "lint": "awesome-lint README.md",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": "@nswds/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nswds/prettier-config": "^1.0.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "awesome-lint": "^2.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "semantic-release": "^25.0.9"
  }
}
